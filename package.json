{
  "name": "deepseek-whale-girl-desk-pet",
  "version": "1.1.0",
  "description": "DeepSeek 余额小鲸鱼桌面宠物挂件（含今日已用、峰谷定价、随机台词、音效、每轮消耗统计与系统托盘）",
  "main": "src/main/index.js",
  "type": "commonjs",
  "scripts": {
    "start": "electron .",
    "dev": "electron .",
    "build:win": "electron-builder --win",
    "build:dir": "electron-builder --dir",
    "build:portable": "electron-builder --win portable"
  },
  "build": {
    "appId": "com.deepseek.whale.pet",
    "productName": "DeepSeek余额小鲸鱼",
    "copyright": "Copyright © 2026",
    "directories": {
      "output": "dist"
    },
    "files": [
      "src/**/*",
      "assets/**/*",
      "package.json"
    ],
    "win": {
      "icon": "assets/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "DeepSeek余额小鲸鱼",
      "installerIcon": "assets/icon.ico",
      "uninstallerIcon": "assets/icon.ico",
      "installerHeaderIcon": "assets/icon.ico"
    }
  },
  "keywords": [
    "deepseek",
    "desk-pet",
    "balance",
    "widget",
    "electron"
  ],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8"
  }
}
